#compdef onrecord

_onrecord() {
    local -a subcommands
    subcommands=(
        'add:onrecord add subcommand'
        'get:onrecord get subcommand'
        'subject:onrecord subject subcommand'
        'due:onrecord due subcommand'
        'check:onrecord check subcommand'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'onrecord subcommand' subcommands
        return
    fi
    case "${words[2]}" in
        add) _arguments -s '--text=[value]:value:' '--asserter=[value]:value:' '--at=[value]:value:' '*--evidence=[evidence source:ref]:receipt:' '--supersedes=[value]:value:' '--subject=[value]:value:' '--due=[value]:value:' '-h[show help]' '--help[show help]' '*:file:_files' ;;
        get) _arguments -s '-h[show help]' '--help[show help]' '*:file:_files' ;;
        subject) _arguments -s '-h[show help]' '--help[show help]' '*:file:_files' ;;
        due) _arguments -s '-h[show help]' '--help[show help]' '*:file:_files' ;;
        check) _arguments -s '-h[show help]' '--help[show help]' '*:file:_files' ;;
        *) _files ;;
    esac
}

_onrecord "$@"
